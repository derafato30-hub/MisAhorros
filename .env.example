# Configuración de Supabase (Pega aquí los valores de Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Opcional para pruebas locales rápidas del Chatbot IA antes de subir la Edge Function:
# (En producción en Vercel esta llave irá en Supabase Edge Function Secrets)
EXPO_PUBLIC_GEMINI_API_KEY=tu-gemini-api-key-opcional
